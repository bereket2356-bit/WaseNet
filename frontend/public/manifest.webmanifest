{
  "name": "WaseNet - Document Authentication",
  "short_name": "WaseNet",
  "description": "Hybrid online/offline document authentication system for Ethiopian public registries",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
