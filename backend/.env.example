# ==============================================================================
# WaseNet Backend Configuration Template (.env.example)
# Compliant with SRS-TC-2026-V1.1 & NFR-S1/NFR-S3
# Copy this file to .env and replace placeholder secrets before production deploy.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Database Connection (PostgreSQL 15+ Neon)
DATABASE_URL=postgresql://neondb_owner:npg_KHgx1Ei9zolt@ep-crimson-field-b5drhguh-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------------- Session Authentication (FR-1.3) ----------------
# High-entropy HMAC-SHA256 secret key for signing 8-hour access tokens (Never commit real secret)
JWT_SECRET=replace-with-a-64-character-random-hex-string-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
JWT_ISSUER=wasenet-authority
JWT_AUDIENCE=wasenet-client

# ---------------- Application-Level Encryption (SRS Section 4.1) ----------------
# 256-bit (32 bytes) master key for AES-256-GCM envelope encryption (hex or base64)
# Encrypts personal identifiers (holder_national_id) and contact details in database.
AES_GCM_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------- Document Signing (FR-2.1 to FR-2.4) ----------------
# Default Active Key ID registered in public_keys
ACTIVE_KID=wase-aa-2026-01
# Optional PEM-encoded NIST P-256 (secp256r1) EC Private Key for server-side signing.
# If left blank, a fresh P-256 key will be initialized.
SERVER_ES256_PRIVATE_KEY_PEM=

# ---------------- Password Hashing Policy (FR-1.1) ----------------
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# ---------------- CORS Configuration ----------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------------- Rate Limiting (per minute) ----------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_FRAUD_PER_MINUTE=10
RATE_LIMIT_AUDIT_BATCH_PER_MINUTE=60

# ---------------- Data Retention Policy (SRS Section 4.1) ----------------
# Days before stale audit records and closed fraud reports are purged
RETENTION_DAYS_AUDIT=365
RETENTION_DAYS_FRAUD=365

# ---------------- Bootstrap Administrator Account (Deliverable 5) ----------------
# Initial administrator account seeded during first-time migration
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@WaseNet2026!
BOOTSTRAP_ADMIN_FULL_NAME=Federal Authentication Directorate Admin
BOOTSTRAP_ADMIN_ORG=National Document Authentication Directorate
